<UserControl x:Class="Vibra_DesktopApp.Views.Components.TrackRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="900">

    <Border x:Name="Root"
            CornerRadius="10"
            Padding="10"
            Margin="0 0 0 10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="0"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Panel.ZIndex" Value="10"/>
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="-2"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.22" ShadowDepth="2"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Leading area: index (keep visible; no hover swap) -->
            <Grid Width="48" Height="40" VerticalAlignment="Center">
                <TextBlock x:Name="IndexText"
                           Text="{Binding Index}"
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Thumbnail -->
            <Border Grid.Column="1"
                    Width="40"
                    Height="40"
                    CornerRadius="8"
                    Background="#666"
                    VerticalAlignment="Center">
                <Image Source="{Binding Track.display_thumbnail_path}" Stretch="UniformToFill" />
            </Border>

            <!-- Track info -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Track.name}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Track.author.name}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Plays (aligned column, slightly shifted toward center) -->
            <TextBlock Grid.Column="3"
                       Text="{Binding TotalPlayedText}"
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Left"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center" />

            <!-- Duration -->
            <TextBlock Grid.Column="4"
                       Text="{Binding DurationText}"
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <!-- Actions -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Margin="0,0,6,0"
                        Command="{Binding AddToWaitlistCommand}">
                    <fa:IconBlock Icon="List" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Make row clickable (exclude actions column so buttons remain clickable) -->
            <Border Background="Transparent" Grid.ColumnSpan="5">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                 Command="{Binding PlayOrPauseCommand}"/>
                </Border.InputBindings>
            </Border>
        </Grid>
    </Border>

</UserControl>
