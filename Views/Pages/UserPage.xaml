<UserControl x:Class="Vibra_DesktopApp.Views.Pages.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:behaviors="clr-namespace:Vibra_DesktopApp.Behaviors"
             xmlns:converters="clr-namespace:Vibra_DesktopApp.Converters"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1250">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:PaymentStatusToBrushConverter x:Key="PaymentStatusToBrush" />
        <converters:PaymentStatusToDotBrushConverter x:Key="PaymentStatusToDotBrush" />
        <converters:PaymentStatusToTextBrushConverter x:Key="PaymentStatusToTextBrush" />

        <Style x:Key="HoverScaleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border CornerRadius="0"
                Background="{DynamicResource WindowBackgroundBrush}"
                Margin="0 5 5 5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="0,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                            <GradientStop Color="#22222222" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="36 0">
                        <Border Width="160" Height="160"
                                CornerRadius="80"
                                Background="#333"
                                ClipToBounds="True">
                            <Grid Width="160" Height="160">
                                <Grid.Clip>
                                    <EllipseGeometry Center="80,80" RadiusX="80" RadiusY="80" />
                                </Grid.Clip>
                                <Image Source="/Assets/Images/defaultUser.png" Stretch="UniformToFill" Width="160" Height="160" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Source="{Binding CurrentUser.display_avatar_path}" Stretch="UniformToFill" Width="160" Height="160" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="20 0 0 0" VerticalAlignment="Center">
                            <TextBlock Text="Hồ sơ" Foreground="#888" FontSize="16"/>
                            <TextBlock Text="{Binding CurrentUser.name}"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       FontSize="54"
                                       FontWeight="Bold"/>
                            <TextBlock Foreground="#888" FontSize="16" Margin="0 6 0 0">
                                <Run Text="{Binding MyPlaylists.Count, Mode=OneWay}"/>
                                <Run Text=" Playlist • "/>
                                <Run Text="{Binding FollowArtists.Count, Mode=OneWay}"/>
                                <Run Text=" nghệ sĩ đang theo dõi"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              PanningDeceleration="0.001"
                              CanContentScroll="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="36 16 36 24">

                        <!-- Menu button -->
                        <Grid>
                            <ToggleButton x:Name="MenuToggle"
                                          Width="46" Height="46"
                                          HorizontalAlignment="Left"
                                          Style="{StaticResource MenuToggleButtonStyle}"
                                          IsChecked="{Binding IsMenuOpen, Mode=TwoWay}">
                                <fa:IconBlock Icon="EllipsisH" Foreground="#888" FontSize="22"/>
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding ElementName=MenuToggle}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="12"
                                        Padding="8"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        Width="220">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <Button Content="Chỉnh sửa hồ sơ"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                Foreground="{DynamicResource AppTextBrush}"
                                                BorderThickness="0"
                                                Padding="10,8"
                                                Command="{Binding EditProfileCommand}"/>
                                        <Button Content="Đăng tải bài hát"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                Foreground="{DynamicResource AppTextBrush}"
                                                BorderThickness="0"
                                                Padding="10,8"
                                                Command="{Binding UploadSongCommand}"/>
                                        <Button Content="Tạo một album"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                Foreground="{DynamicResource AppTextBrush}"
                                                BorderThickness="0"
                                                Padding="10,8"
                                                Command="{Binding CreateAlbumCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- My Albums -->
                        <StackPanel Margin="0 18 0 0"
                                    Visibility="{Binding HasMyAlbums, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Album của tôi"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0 0 0 10"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly"
                                           ClipToBounds="False"
                                           Height="280"
                                          behaviors:ScrollBehavior.HorizontalScrollOnly="True">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource HorizontalScrollBarStyle}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding MyAlbums}" ClipToBounds="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" ClipToBounds="False"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="190"
                                                    Style="{StaticResource HoverScaleButtonStyle}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0 0 18 0"
                                                    Command="{Binding DataContext.OpenAlbumCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Border Width="180" Height="180" CornerRadius="14" Background="#333" ClipToBounds="True">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,180,180" RadiusX="14" RadiusY="14"/>
                                                        </Border.Clip>
                                                        <Grid Width="180" Height="180">
                                                            <Image Source="/Assets/Images/default.jpg" Stretch="UniformToFill" Width="180" Height="180" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Image Source="{Binding display_thumbnail_path}" Stretch="UniformToFill" Width="180" Height="180" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Margin="0 8 0 0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding name}"
                                                                       Foreground="{DynamicResource AppTextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding created_at, StringFormat= Năm {0:yyyy}}"
                                                                       Foreground="#888"
                                                                       FontSize="12"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Width="34" Height="34"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.EditAlbumCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <fa:IconBlock Icon="Edit" Foreground="#888" FontSize="16"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- My Songs -->
                        <StackPanel Margin="0 18 0 0"
                                    Visibility="{Binding HasMySongs, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Danh sách bài hát của tôi"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0 0 0 10"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly"
                                           ClipToBounds="False"
                                           Padding="6,8"
                                          behaviors:ScrollBehavior.HorizontalScrollOnly="True">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource HorizontalScrollBarStyle}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding MySongs}" ClipToBounds="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" ClipToBounds="False"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent"
                                                    Style="{StaticResource HoverScaleButtonStyle}"
                                                    BorderThickness="0"
                                                    Margin="0 0 18 0"
                                                    Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Border Width="128" Height="128" CornerRadius="64" Background="#333" ClipToBounds="True">
                                                        <Grid Width="128" Height="128">
                                                            <Grid.Clip>
                                                                <EllipseGeometry Center="64,64" RadiusX="64" RadiusY="64" />
                                                            </Grid.Clip>
                                                            <Image Source="/Assets/Images/default.jpg" Stretch="UniformToFill" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Image Source="{Binding display_thumbnail_path}" Stretch="UniformToFill" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>
                                                     <Grid Margin="0 8 0 0" Width="128">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*"/>
                                                             <ColumnDefinition Width="Auto"/>
                                                         </Grid.ColumnDefinitions>

                                                         <TextBlock Grid.Column="0"
                                                                    Text="{Binding name}"
                                                                    Foreground="{DynamicResource AppTextBrush}"
                                                                    FontWeight="SemiBold"
                                                                    TextTrimming="CharacterEllipsis"/>

                                                         <Button Grid.Column="1"
                                                                 Width="28" Height="28"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Padding="0"
                                                                 Command="{Binding DataContext.EnqueueSongCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 CommandParameter="{Binding}">
                                                             <fa:IconBlock Icon="FolderOpen" Foreground="#888" FontSize="18"/>
                                                         </Button>
                                                     </Grid>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- My Playlists -->
                        <StackPanel Margin="0 18 0 0"
                                    Visibility="{Binding HasMyPlaylists, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Playlist của tôi"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0 0 0 10"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly"
                                           ClipToBounds="False"
                                          Height="190"
                                          behaviors:ScrollBehavior.HorizontalScrollOnly="True">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource HorizontalScrollBarStyle}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding MyPlaylists}" ClipToBounds="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" ClipToBounds="False"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="150"
                                                    Style="{StaticResource HoverScaleButtonStyle}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Margin="8 0 10 0"
                                                    Command="{Binding DataContext.OpenAlbumCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Border Width="140" Height="140" CornerRadius="14" Background="#333" ClipToBounds="True">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,140,140" RadiusX="14" RadiusY="14"/>
                                                        </Border.Clip>
                                                        <Grid Width="140" Height="140">
                                                            <Image Source="/Assets/Images/default.jpg" Stretch="UniformToFill" Width="140" Height="140" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Image Source="{Binding display_thumbnail_path}" Stretch="UniformToFill" Width="140" Height="140" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding name}"
                                                               Foreground="{DynamicResource AppTextBrush}"
                                                               FontWeight="SemiBold"
                                                               Margin="0 8 0 0"
                                                               Width="140"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Followed Artists -->
                        <StackPanel Margin="0 18 0 0"
                                    Visibility="{Binding HasFollowArtists, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Đang theo dõi"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0 0 0 10"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly"
                                           ClipToBounds="False"
                                          Height="190"
                                          behaviors:ScrollBehavior.HorizontalScrollOnly="True">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource HorizontalScrollBarStyle}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding FollowArtists}" ClipToBounds="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" ClipToBounds="False"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent"
                                                    Style="{StaticResource HoverScaleButtonStyle}"
                                                    BorderThickness="0"
                                                    Margin="0 0 18 0"
                                                    Command="{Binding DataContext.OpenArtistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding display_artist}">
                                                <StackPanel>
                                                    <Border Width="128" Height="128" CornerRadius="64" Background="#333" ClipToBounds="True">
                                                        <Grid Width="128" Height="128">
                                                            <Grid.Clip>
                                                                <EllipseGeometry Center="64,64" RadiusX="64" RadiusY="64" />
                                                            </Grid.Clip>
                                                            <Image Source="/Assets/Images/defaultUser.png" Stretch="UniformToFill" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Image Source="{Binding display_artist.display_avatar_path}" Stretch="UniformToFill" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding display_name}"
                                                               Foreground="#888"
                                                               Margin="0 8 0 0"
                                                               Width="128"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Bills -->
                        <StackPanel Margin="0 22 0 0"
                                    Visibility="{Binding HasBills, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Lịch sử thanh toán"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0 0 0 10"/>

                            <Border CornerRadius="10"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    Background="#141414">
                                <DataGrid ItemsSource="{Binding Bills}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          HorizontalScrollBarVisibility="Disabled"
                                            ColumnWidth="*"
                                          IsReadOnly="True"
                                          Background="Transparent"
                                          Foreground="{DynamicResource AppTextBrush}"
                                          BorderThickness="0"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1F1F1F"/>
                                            <Setter Property="Foreground" Value="#FFE5D6"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="12,10"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="MinHeight" Value="44"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1A1A1A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="12,10"/>
                                            <Setter Property="Foreground" Value="#B0B0B0"/>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Header="Mã giao dịch" Binding="{Binding id}"/>
                                        <DataGridTextColumn Width="*" Header="Ngày thanh toán" Binding="{Binding created_at, StringFormat={}{0:dd/MM/yyyy}}"/>
                                        <DataGridTextColumn Width="*" Header="Số tiền" Binding="{Binding amount_text}"/>
                                        <DataGridTextColumn Width="*" Header="Tên" Binding="{Binding item_name}"/>
                                        <DataGridTextColumn Width="*" Header="Gói dịch vụ" Binding="{Binding package_name}"/>

                                        <DataGridTemplateColumn Width="*" Header="Trạng thái">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10"
                                                            Padding="10,4"
                                                            Margin="6"
                                                            Background="{Binding status, Converter={StaticResource PaymentStatusToBrush}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8"
                                                                     Fill="{Binding status, Converter={StaticResource PaymentStatusToDotBrush}}"
                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock Margin="8,0,0,0"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding status, Converter={StaticResource PaymentStatusToTextBrush}}"
                                                                       Text="{Binding status_text}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</UserControl>
