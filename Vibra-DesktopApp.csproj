<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vibra_DesktopApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  <ApplicationIcon>Assets\Images\MyLogoWhite.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Images\default.jpg" />
    <None Remove="Assets\Images\defaultUser.png" />
    <None Remove="Assets\Images\LogoText.png" />
    <None Remove="Assets\Images\MyLogo.png" />
    <None Remove="Assets\Images\MyLogoGray.png" />
    <None Remove="Assets\Images\MyLogoWhite.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Images\MyLogoWhite.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controls\" />
    <Folder Include="Languages\" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.0" />
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.74.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\default.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\defaultUser.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\LogoText.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\MyLogo.png" />
    <Resource Include="Assets\Images\MyLogoGray.png" />
    <Resource Include="Assets\Images\MyLogoWhite.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\Pages\CategorySongsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\Pages\CategorySongsPage.xaml.cs">
      <DependentUpon>CategorySongsPage.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\Modals\EditPlaylistWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\Modals\EditPlaylistWindow.xaml.cs">
      <DependentUpon>EditPlaylistWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
